# Copy to .env, edit, and chmod 600 .env. Values are literal, without quotes.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=school
MYSQL_USER=score_engine
MYSQL_PASSWORD=CHANGE_ME
# Use a verified CA certificate for a remote database:
# MYSQL_SSL_CA=/etc/ssl/certs/mysql-ca.pem
# Or use a local socket:
# MYSQL_UNIX_SOCKET=/var/run/mysqld/mysqld.sock
